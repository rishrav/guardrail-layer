# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Gateway ---
GUARDRAIL_ENV=dev
GUARDRAIL_API_KEY=change-me-local-dev-key
GUARDRAIL_POLICY_PATH=policies/default.yaml
GUARDRAIL_FAIL_OPEN_TIERS=0,1

# --- PostgreSQL ---
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guardrail
DATABASE_URL=postgresql+asyncpg://guardrail:change-me@localhost:5432/guardrail

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Local models (Ollama) ---
# macOS: run Ollama natively; from inside Docker use http://host.docker.internal:11434
MODEL_BASE_URL=http://localhost:11434
MODEL_TIMEOUT_S=30
JUDGE_MODEL=qwen3:8b
GUARDIAN_MODEL=granite3-guardian:2b

# --- Injection detection cascade ---
INJECTION_MODEL_DIR=models/weights/deberta-v3-prompt-injection-v2
LLM_CLASSIFIER_ENABLED=true
DETECTION_AMBIGUOUS_LOW=0.3
DETECTION_AMBIGUOUS_HIGH=0.8

# --- Automated adjudicator (no human in the loop) ---
ADJUDICATOR_ENABLED=true
ADJUDICATOR_MODELS_ENABLED=true
ADJUDICATOR_TIMEOUT_S=60
GUARDIAN_RISK=unethical_behavior

# --- Optional cloud overrides (leave blank to stay fully local) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
